# ─────────────────────────────────────────────────────────────────────────────
# Portal de Gestión Documental — variables de entorno
# Copie este archivo como .env (desarrollo) o configúrelas en el servidor.
# NUNCA suba valores reales al repositorio. Ningún valor de este archivo llega al navegador.
# ─────────────────────────────────────────────────────────────────────────────

# Modo de ejecución:
#   demo        → datos ficticios, inicio de sesión de demostración, almacenamiento local.
#                 No se conecta con Microsoft 365 y la interfaz lo indica siempre.
#   production  → Microsoft Entra ID + Microsoft Graph + SharePoint Online reales.
APP_MODE=demo

# URL pública del portal (sin barra final). Se usa para el retorno de OAuth y las invitaciones B2B.
APP_URL=http://localhost:3000

# Zona horaria para mostrar fechas.
APP_TIMEZONE=America/Bogota

# Base de datos PostgreSQL (una base distinta por entorno: la BD queda sellada como DEMO o PRODUCTION).
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/portal_documental

# Secretos del servidor (generar con: openssl rand -base64 48  /  openssl rand -base64 32)
SESSION_SECRET=
# 32 bytes en base64: cifra la caché de tokens de Microsoft y las URL de sesiones de carga.
TOKEN_ENCRYPTION_KEY=

# true solo si el portal está detrás de un proxy inverso de confianza (para registrar la IP de origen).
TRUST_PROXY=false

# ─── Microsoft Entra ID (registro de aplicación) ─────────────────────────────
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Use secreto O certificado (recomendado en producción).
ENTRA_CLIENT_SECRET=
ENTRA_CLIENT_CERT_THUMBPRINT=
ENTRA_CLIENT_CERT_PRIVATE_KEY_PATH=
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# ─── Microsoft Graph ─────────────────────────────────────────────────────────
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
# Permisos DELEGADOS para archivos (mínimo privilegio): Sites.Selected.
# Alternativa si Sites.Selected no es viable en el tenant: Files.ReadWrite.All (ver docs/permisos.md).
GRAPH_DELEGATED_SCOPES=Sites.Selected
# Permisos delegados que solo usa el administrador (invitaciones B2B y búsqueda en el directorio).
GRAPH_ADMIN_SCOPES=User.Invite.All User.ReadBasic.All

# ─── SharePoint Online ───────────────────────────────────────────────────────
# Valores derivados del enlace proporcionado (verificar con `npm run sp:discover`).
SHAREPOINT_HOSTNAME=dac365.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/OperacionesIngenierayMantenimiento/IMA
SHAREPOINT_LIBRARY_URL=/sites/OperacionesIngenierayMantenimiento/IMA/Proyectos de Inversin Operaciones
# Identificadores reales: se obtienen con `npm run sp:discover` (no inventar).
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# ─── Solo modo demostración ──────────────────────────────────────────────────
DEMO_STORAGE_DIR=./.demo-storage
